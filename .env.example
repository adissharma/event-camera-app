# Copy to `.env.local` and fill in. `.env.local` is gitignored — never commit it.
#
# Only PUBLIC keys belong in this file. `EXPO_PUBLIC_*` variables are inlined
# into the JavaScript bundle and are readable by anyone with the app, so the
# anon/publishable key is the only Supabase key that may appear here.
#
# The service-role key must NEVER be placed in this file, in the app, or in any
# client-side code. It belongs only in Edge Function secrets, where it is set
# with `supabase secrets set`.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=your-revenuecat-ios-public-sdk-key
EXPO_PUBLIC_ENABLE_REAL_PURCHASES=false

# When these are absent the app runs against the typed development fallback:
# the same code paths and the same interfaces, backed by an in-memory adapter.
# It is not a mock-only app — supplying real credentials switches the adapter
# with no code change.
